# ============================================================
# AgentOps Platform – Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL async connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# JWT signing secret – must be a 32+ character random string in production
SECRET_KEY=change-me-in-production-use-32-char-random-string

# JWT algorithm
ALGORITHM=HS256

# JWT access token TTL in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Stripe keys (use test keys for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Runtime environment – controls logging verbosity, CORS policy, etc.
# Allowed values: development | staging | production
ENVIRONMENT=development
